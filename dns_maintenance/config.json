{
  "resolvers": [
    "1.1.1.1",
    "8.8.8.8",
    "9.9.9.9"
  ],
  "timeout_seconds": 2.0,
  "lifetime_seconds": 4.0,
  "negative_votes_required": 2,
  "suspect_after_failures": 3,
  "quarantine_after_failures": 7,
  "expire_after_days": 30,
  "max_workers": 20,
  "collections": [
    {
      "name": "telegram",
      "active": "Telegram_DNS",
      "manual": "dns/telegram/manual.txt",
      "discovered": "dns/telegram/discovered.txt",
      "pending": "dns/telegram/pending.txt",
      "suspect": "dns/telegram/suspect.txt",
      "quarantine": "dns/telegram/quarantine.txt",
      "expired": "dns/telegram/expired.txt",
      "state": "dns/telegram/state.json",
      "discovery": {
        "enabled": true,
        "state": "dns/telegram/discovery_state.json",
        "certspotter": {
          "domains": [
            "telegram.org",
            "telegram.me",
            "t.me"
          ],
          "max_pages_per_domain": 5,
          "request_timeout_seconds": 30.0,
          "user_agent": "DKHNV-DNS-Maintenance/1.0"
        }
      },
      "service_check": {
        "enabled": true,
        "state": "dns/telegram/service_state.json",
        "alive": "dns/telegram/service_alive.txt",
        "suspect": "dns/telegram/service_suspect.txt",
        "dead": "dns/telegram/service_dead.txt",
        "unknown": "dns/telegram/service_unknown.txt",
        "port": 443,
        "path": "/",
        "timeout_seconds": 4.0,
        "max_workers": 10,
        "max_ipv4_per_host": 3,
        "suspect_after_failures": 3,
        "dead_after_failures": 7,
        "user_agent": "DKHNV-DNS-Maintenance/1.0",
        "history_limit": 14,
        "failure_log_limit": 50,
        "report": "dns/telegram/report.md"
      }
    }
  ]
}
